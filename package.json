{
  "name": "woyomi-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "woyomi source plugins and the build pipeline for the hostable plugin repository",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "repo": "pnpm run build && node scripts/build-repo.mjs"
  }
}
